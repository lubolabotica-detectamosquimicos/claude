rules_version = '2';

// Los pagos solo los escribe/lee el SERVIDOR (firebase-admin, que ignora estas reglas).
// Desde el navegador NADIE puede leer ni escribir en Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
