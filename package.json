{
  "name": "lubo-la-botica",
  "private": true,
  "version": "1.0.0",
  "description": "LuBo la botica — lector de ingredientes con semáforo LuBo (100% local/offline)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/test-matcher.ts && tsx scripts/test-api.ts",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "clean": "rm -rf dist",
    "keys:generate": "node scripts/generate-entitlement-keys.mjs",
    "check:onedrive": "tsx scripts/check-onedrive.ts"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.3.9",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "read-excel-file": "^9.3.12",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
