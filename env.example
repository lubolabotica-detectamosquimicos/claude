# ════════════════════════════════════════════════════════════════════
#  LuBo la botica — variables de entorno
#
#  A) VARIABLES PÚBLICAS  (prefijo VITE_) → .env.local en tu PC y Vercel.
#     Quedan dentro del JavaScript del navegador: solo valores públicos.
#  B) VARIABLES PRIVADAS DEL SERVIDOR (sin VITE_) → SOLO en Vercel
#     (Settings ▸ Environment Variables). Nunca en GitHub ni en .env.local compartido.
# ════════════════════════════════════════════════════════════════════

# ───────────── A) PÚBLICAS ─────────────

# Firebase Authentication (panel administrativo) — Firebase Console ▸ Configuración ▸ App web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Correos que pueden abrir el panel administrativo (separados por coma)
VITE_ADMIN_EMAILS=tu-correo@ejemplo.com

# Enlaces de pago de Mercado Pago (opcionales: si faltan se usan los actuales)
VITE_PAYMENT_LINK_MONTHLY=https://mpago.li/1TxnQQk
VITE_PAYMENT_LINK_ANNUAL=https://mpago.li/1uCi2kF
VITE_PAYMENT_LINK_SUPPORT=https://link.mercadopago.com.co/graciasporayudarnos

# Clave PÚBLICA para verificar los accesos pagados (la genera: npm run keys:generate)
VITE_ENTITLEMENT_PUBLIC_KEY=

# (Opcional) cada cuántos minutos revisa si el Excel de OneDrive cambió (por defecto 10)
VITE_SYNC_INTERVAL_MINUTES=10

# (Solo desarrollo local) permite probar planes de pago sin pagar. Ignorado en producción.
# VITE_DEV_ALLOW_UNVERIFIED_PLANS=true


# ───────────── B) PRIVADAS (solo servidor / Vercel) ─────────────

# Excel maestro en OneDrive (solo lectura). Debe estar compartido como "Cualquier persona con el enlace puede ver".
ONEDRIVE_FILE_URL=

# Mercado Pago ▸ Tus integraciones ▸ tu aplicación
MP_ACCESS_TOKEN=            # Credenciales de PRODUCCIÓN ▸ Access Token
MP_WEBHOOK_SECRET=          # Webhooks ▸ "Clave secreta"

# Firebase ▸ Configuración ▸ Cuentas de servicio ▸ Generar nueva clave privada (JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=       # el valor "private_key" del JSON, con los saltos de línea como \n

# Clave PRIVADA de firma (la genera: npm run keys:generate)
ENTITLEMENT_PRIVATE_KEY=

# (Opcional) precios y mínimo del aporte voluntario, en COP. Deben coincidir con tus enlaces de pago.
# PLAN_PRICE_MONTHLY=6500
# PLAN_PRICE_ANNUAL=30000
# SUPPORT_MIN_AMOUNT=5000
